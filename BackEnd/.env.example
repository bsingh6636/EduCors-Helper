PORT=9090
NODE_ENV=development
MONGO_SRV=mongodb://127.0.0.1:27017/educors
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
FRONTEND_URL=http://localhost:5173
# Set only when exactly one trusted reverse proxy is in front of this server.
TRUST_PROXY=0
# Use "none" only for a frontend and API on different sites, with HTTPS.
COOKIE_SAME_SITE=lax
# Set to "proxy" on a separate deployment that only serves /api/getData (no accounts).
API_ROLE=
